# ============================================================
# NSE Momentum Groww AI Bot - .gitignore
# SECURITY: Never commit credentials, tokens, or keys
# ============================================================

# Environment & secrets
.env
.env.local
.env.production
*.key
*.pem
*.p12
secrets/
credentials/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# Jupyter
.ipynb_checkpoints
*.ipynb

# Logs
logs/
*.log
*.log.*
trade_logs/
backtest_results/

# Data & cache
data/cache/
data/raw/
data/*.db
data/*.json
*.csv
*.pkl
*.parquet
*.h5
*.hdf5
__pycache__/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Charts & images (generated at runtime)
charts/
*.png
*.jpg
*.jpeg
!docs/images/

# Trainer artifacts
trainer_results/
model_checkpoints/
optimization_results/

# Groww specific
groww_tokens/
auth_tokens/
session_data/
