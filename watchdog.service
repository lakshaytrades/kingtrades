[Unit]
Description=SataVector Watchdog — Auto-restarts the trading bot
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/user/kingtrades
ExecStart=/usr/bin/python3 /home/user/kingtrades/watchdog.py
Restart=always
RestartSec=15
StandardOutput=append:/home/user/kingtrades/logs/watchdog.log
StandardError=append:/home/user/kingtrades/logs/watchdog.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
