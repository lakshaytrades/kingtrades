# ============================================================
# SataVector — NSE Momentum AI Bot
# Copy this to .env and fill in your actual values
# NEVER commit .env to git — it contains live trading credentials
# ============================================================

# ═══════════════════════════════════════════════
#  ALPACA (US stocks — NYSE/NASDAQ, 4x leverage)
# ═══════════════════════════════════════════════
# Get keys at: https://alpaca.markets → Paper Trading → API Keys
# Paper trading is FREE. Switch to live keys when ready.

ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# true = paper trading (safe, free, no real money)
ALPACA_PAPER=true

# ---- Telegram Bot ----
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---- Gemini AI Brain ----
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- News API (sentiment filter) ----
# Get free key at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# ---- Email Reports ----
REPORT_EMAIL=your@email.com
GMAIL_SENDER=your@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
DISCORD_WEBHOOK_URL=

# ---- Trading Configuration ----
# DANGER: Set to True ONLY when ready for LIVE real-money trading
# For paper trading: set True so orders go to Alpaca paper endpoint
LIVE_TRADING_ENABLED=True
# Capital cap per day. 0 = use 10% of account equity automatically
MAX_DAILY_CAPITAL=93000
MAX_RISK_PER_TRADE_PCT=0.8
DAILY_LOSS_LIMIT_PCT=1.5

# ---- Account Type & PDT ----
# CASH = no PDT limit (< $25k accounts — max 3 day trades/5 days)
# MARGIN = PDT rules apply (< $25k)
ACCOUNT_TYPE=CASH
PDT_ENFORCE=False

# ---- Signal Score Thresholds ----
# Min score to generate a signal (pre-filter). Default: 63
MIN_SIGNAL_SCORE=63
# Min score to execute an order (post-booster gate). Default: 65
FINAL_EXEC_MIN_SCORE=65
# ADX minimum trend strength. Default: 18
ADX_MIN_TREND=18

# ---- Crypto (BTC/ETH) — set False for equity-only mode ----
CRYPTO_ENABLED=False

# ---- Short Selling ----
SHORT_SELLING_ENABLED=True

# ---- Watchlist (US symbols, comma-separated) ----
# Leave empty to use built-in US momentum list
CUSTOM_WATCHLIST=NVDA,TSLA,AAPL,MSFT,META,AMZN,GOOGL,AMD,NFLX,COIN,SPY,QQQ

# ---- US Options Scalping (Alpaca) ----
# Request options trading in your Alpaca dashboard (takes 1-2 days to approve)
OPTIONS_ENABLED=True
OPTIONS_MIN_STOCK_SCORE=70
OPTIONS_MAX_POSITIONS=3
OPTIONS_MAX_PREMIUM_PCT=5.0
OPTIONS_STOP_PCT=45
OPTIONS_TARGET1_PCT=80
OPTIONS_TARGET2_PCT=150
OPTIONS_PREFERRED_DTE=1
UOA_SCAN_ENABLED=True

# ---- Daily Profit Target ($) ----
DAILY_PROFIT_TARGET=200

# ---- Volume Profile ----
VP_ENABLED=True

# ═══════════════════════════════════════════════
#  GROWW (NSE equity — primary broker)
# ═══════════════════════════════════════════════
# Get via Groww app → Profile → API / Developer settings
# TOTP secret comes from the QR code shown during 2FA setup
# Scan it with Google Authenticator → Settings → Export → copy secret

GROWW_AUTH_TOKEN=your_groww_auth_token_here
GROWW_CLIENT_ID=your_groww_client_id_here
GROWW_CLIENT_SECRET=your_groww_client_secret_here
GROWW_EMAIL=your_groww_email_here
GROWW_PASSWORD=your_groww_password_here
GROWW_TOTP_SECRET=your_groww_totp_secret_here

# ═══════════════════════════════════════════════
#  UPSTOX (NSE equity — primary India broker)
# ═══════════════════════════════════════════════
# Step 1 → Login at https://upstox.com/developer/api-documentation/
# Step 2 → Create an app → get API Key + Secret
# Step 3 → Complete daily OAuth2 flow to get Access Token
# Note: Access Token expires daily (~03:30 IST) — use auth_upstox.py
#        or set UPSTOX_ACCESS_TOKEN env var each morning
#
# SDK: pip install upstox-python-sdk
# Usage: from auth_upstox import get_upstox_client; client = get_upstox_client()

UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here
UPSTOX_REDIRECT_URI=https://127.0.0.1/callback

# Upstox TOTP Auto-Login (optional — enables automatic daily token renewal at 8:30 AM IST)
# Without these, token must be renewed manually each morning via Telegram /newtoken
# UPSTOX_TOTP_SECRET: Base32 secret from Upstox 2FA setup page (not a TOTP code — the seed)
#   Get it: Upstox app → Profile → 2FA/Security → "Can't scan QR?" → copy Base32 key
UPSTOX_EMAIL=your_upstox_email@example.com
UPSTOX_PASSWORD=your_upstox_password
UPSTOX_TOTP_SECRET=YOUR_BASE32_TOTP_SECRET_FROM_UPSTOX_2FA

# ---- Circuit breaker settings ----
# Trading halts when daily loss exceeds this fraction of capital (0.03 = 3%)
DAILY_LOSS_HALT_PCT=0.03
# Trading pauses after this many consecutive losing trades
CONSEC_LOSS_HALT=5
# Duration of the consecutive-loss pause, in minutes
CONSEC_LOSS_PAUSE_MIN=30

# ---- Upstox auto-renewal ----
# Set to true to enable automatic daily TOTP token renewal at 8:30 AM IST
UPSTOX_AUTO_RENEW_ENABLED=true

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- Timezone ----
TIMEZONE=Asia/Kolkata
