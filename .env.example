# ============================================================
# KingTrades — US Momentum Bot (Alpaca) + NSE Legacy (Groww)
# Copy this to .env and fill in your actual values
# NEVER commit .env to git — it contains live trading credentials
# ============================================================

# ---- BROKER SELECTION ----
# alpaca = US stocks via Alpaca (default, recommended)
# groww  = NSE India via Groww (legacy)
BROKER=alpaca

# ═══════════════════════════════════════════════
#  ALPACA (US stocks — NYSE/NASDAQ, 4x leverage)
# ═══════════════════════════════════════════════
# Get keys at: https://alpaca.markets → Paper Trading → API Keys
# Paper trading is FREE and lets you test with no real money.
# Switch to live keys when ready.

# Your Alpaca API Key (starts with PK... for paper, AK... for live)
ALPACA_API_KEY=your_alpaca_api_key_here
# Your Alpaca Secret Key
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# true = paper trading (safe, free, no real money)
# false = LIVE trading (real money — only when confident)
ALPACA_PAPER=true

# ═══════════════════════════════════════════════
#  GROWW (NSE India — legacy, set BROKER=groww)
# ═══════════════════════════════════════════════
# ---- Groww Login Credentials ----
GROWW_EMAIL=your_groww_email@gmail.com
GROWW_PASSWORD=your_groww_password
# Account 2FA TOTP (the one you scan at Groww app login → Authenticator)
GROWW_TOTP_SECRET=your_account_totp_base32_secret
GROWW_PIN=your_4_digit_pin

# ---- Groww Trade API (Algo Platform) ----
GROWW_CLIENT_ID=
GROWW_CLIENT_SECRET=
GROWW_API_KEY_TOTP=

# ---- Daily Reports — Wake Up & Read What The Bot Did ----
# Email report (beautiful HTML) sent to you every evening after market close
REPORT_EMAIL=your@email.com
# Gmail account the bot sends FROM (can be same as REPORT_EMAIL)
GMAIL_SENDER=your@gmail.com
# Google App Password — NOT your Gmail password
# Get it: myaccount.google.com → Security → 2-Step Verification → App Passwords
# Create one for "Mail", copy the 16-char code here
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Discord webhook (free, optional — create at discord.com → Server → Integrations)
DISCORD_WEBHOOK_URL=

# ---- Telegram Bot ----
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---- Gemini AI Brain (primary AI — market intelligence, signal scoring, daily review) ----
# Get free key at: https://aistudio.google.com/app/apikey
# Required for AI-powered signal explanations, morning brief, and trade review
GEMINI_API_KEY=your_gemini_api_key_here
# Model: gemini-1.5-flash (fast, free tier) or gemini-1.5-pro (more accurate)
GEMINI_MODEL=gemini-1.5-flash

# ---- News API (for sentiment filter) ----
# Get free key at: https://newsapi.org
NEWS_API_KEY=your_newsapi_key_here
# Optional: Alpha Vantage for economic calendar
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# ---- Trading Configuration ----
# DANGER: Set to True ONLY when ready for LIVE real-money trading
LIVE_TRADING_ENABLED=False
# Maximum capital to deploy per day (INR)
MAX_DAILY_CAPITAL=50000
# Maximum risk per trade as % of capital
MAX_RISK_PER_TRADE_PCT=0.5
# Daily loss limit as % of capital
DAILY_LOSS_LIMIT_PCT=2.0

# ---- Watchlist ----
# Alpaca: comma-separated US symbols (leave empty to use built-in US momentum list)
CUSTOM_WATCHLIST=NVDA,TSLA,AAPL,MSFT,META,AMZN,GOOGL,AMD,NFLX,COIN
# Groww (NSE): CUSTOM_WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK

# ---- Option Chain Analysis ----
# Uses NSE public API — NO API key required
# Set to True to enable PCR, Max Pain, OI wall analysis
OPTION_CHAIN_ENABLED=True

# ---- FII/DII Flow Tracker ----
# Uses NSE provisional data — NO API key required
# Institutional flow tracking: FII buying = bullish tailwind
FII_DII_ENABLED=True

# ---- Volume Profile ----
# Computed from live Groww candle data — no external API needed
VP_ENABLED=True

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- Timezone ----
# Alpaca: America/New_York (ET) — handled automatically
# Groww:  Asia/Kolkata (IST) — server stays UTC, bot converts
TIMEZONE=America/New_York
